<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ChessUniverse.Mobile.Pages.PuzzleBoardPage"
    Title="{Binding Title}">

    <VerticalStackLayout
        Padding="16"
        Spacing="16">

        <Label
            Text="{Binding Title}"
            FontSize="28"
            FontAttributes="Bold" />

        <Label
            Text="{Binding StatusMessage}"
            FontSize="16"
            TextColor="Gray" />

        <Grid
    HorizontalOptions="Center"
    ColumnDefinitions="Auto,Auto"
    ColumnSpacing="10">

        <Grid
            x:Name="BoardGrid"
            Grid.Column="0"
            WidthRequest="260"
            HeightRequest="260"
            RowDefinitions="*,*,*,*,*,*,*,*"
            ColumnDefinitions="*,*,*,*,*,*,*,*" />

        <VerticalStackLayout
            Grid.Column="1"
            WidthRequest="48"
            VerticalOptions="Center">

        <Button
            Text="→"
            WidthRequest="48"
            HeightRequest="56"
            FontSize="26"
            FontAttributes="Bold"
            TextColor="White"
            BackgroundColor="#2563EB"
            CornerRadius="14"
            IsVisible="{Binding IsNextButtonVisible}"
            Clicked="OnNextClicked" />
        </VerticalStackLayout>

        </Grid>

    </VerticalStackLayout>
</ContentPage>
