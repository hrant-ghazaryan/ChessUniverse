<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ChessUniverse.Mobile.Pages.PuzzleBoardPage"
    Title="{Binding Title}">

    <VerticalStackLayout
        Padding="16"
        Spacing="16">

        <Label
            Text="{Binding Title}"
            FontSize="28"
            FontAttributes="Bold" />

        <Label
            Text="{Binding StatusMessage}"
            FontSize="16"
            TextColor="Gray" />

        <Grid
            x:Name="BoardGrid"
            WidthRequest="336"
            HeightRequest="336"
            HorizontalOptions="Center"
            RowDefinitions="*,*,*,*,*,*,*,*"
            ColumnDefinitions="*,*,*,*,*,*,*,*" />

    </VerticalStackLayout>
</ContentPage>
