<Window x:Class="ChessUniverse_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessUniverse_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid Name="MainGrid">
        <!-- board.png - Margin="132,45,441,0" -->
        <Image Name="board" Source="/images/board/chessboard.png" Margin="132,62,415,16"/>
        <!-- PawnPromotion! -->
        <Grid x:Name="WhitePromotionOverlay"  Visibility="Collapsed" Background="#80000000" Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Background="White" >
                <Image Name="wh_queen" Width="50" Height="50" Tag="Queen" Source="/images/figures/white-queen.png" MouseDown="PromotionClick" />
                <Image Name="wh_rook" Width="50" Height="50" Tag="Rook" Source="/images/figures/white-ship.png" MouseDown="PromotionClick"/>
                <Image Name="wh_bishop" Width="50" Height="50" Tag="Bishop" Source="/images/figures/white-elephant.png" MouseDown="PromotionClick"/>
                <Image Name="wh_knight" Width="50" Height="50" Tag="Knight" Source="/images/figures/white-horse.png" MouseDown="PromotionClick"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="BlackPromotionOverlay"  Visibility="Collapsed" Background="#80000000" Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Background="White" >
                <Image Name="bl_queen" Width="50" Height="50" Tag="Queen" Source="/images/figures/black-queen.png" MouseDown="PromotionClick"/>
                <Image Name="bl_rook" Width="50" Height="50" Tag="Rook" Source="/images/figures/black-ship.png" MouseDown="PromotionClick"/>
                <Image Name="bl_bishop" Width="50" Height="50" Tag="Bishop" Source="/images/figures/black-elephant.png" MouseDown="PromotionClick"/>
                <Image Name="bl_knight" Width="50" Height="50" Tag="Knight" Source="/images/figures/black-horse.png" MouseDown="PromotionClick"/>
            </StackPanel>
        </Grid>

        <Grid Name="grid_figure"
      Height="453"
      Width="453"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Margin="224,102,0,0">
        </Grid>

        <Label Name="label1" Content="X:" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="750,307,0,0"></Label>
        <Label Name="label2" Content="Y:" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="800,307,0,0"></Label>
        <Label Name="label3" Content="M:" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="850,307,0,0"></Label>

        <WrapPanel Name="BlackCaptures" HorizontalAlignment="Left" Height="80" Margin="757,80,0,0" VerticalAlignment="Top" Width="179"/>
        <WrapPanel Name="WhiteCaptures" HorizontalAlignment="Left" Height="80" Margin="757,538,0,0" VerticalAlignment="Top" Width="179"/>
        <Button Name="Previous" Content="PREVIOUS" HorizontalAlignment="Left" Height="60" Margin="745,450,0,0" VerticalAlignment="Top" Width="119" Click="PreviousClick"/>
        <Button Content="NEXT" HorizontalAlignment="Left" Height="61" Margin="869,450,0,0" VerticalAlignment="Top" Width="119"/>
        <Button Content="NEW GAME"
        Width="119"
        Height="40"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="745,350,0,0"
        Click="NewGameClick" />
        <Label x:Name="MoveShower" Content="White" HorizontalAlignment="Left" Height="46" Margin="869,396,0,0" VerticalAlignment="Top" Width="119" FontWeight= "Heavy" HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" FontSize="30"/>
        <Label Content="Turn" HorizontalAlignment="Left" Height="46" Margin="745,396,0,0" VerticalAlignment="Top" Width="119" FontWeight= "Heavy" HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center" FontSize="30"/>
    </Grid>
</Window>
